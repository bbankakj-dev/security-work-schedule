rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- ฟังก์ชันช่วยตรวจสิทธิ์ ----
    // ต้องล็อกอินด้วย Firebase Auth และไม่ใช่ Anonymous (เดิม `request.auth != null` ผ่านแม้เป็น Anonymous)
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    // เป็น Supervisor/Admin ที่ Admin อนุมัติแล้ว (status == ACTIVE)
    function isActiveStaff() {
      return signedIn() && exists(profilePath())
        && get(profilePath()).data.status == 'ACTIVE'
        && get(profilePath()).data.role in ['SUPERVISOR', 'ADMIN'];
    }
    function isAdmin() {
      return isActiveStaff() && get(profilePath()).data.role == 'ADMIN';
    }

    // ---- บัญชีผู้ใช้ ----
    match /users/{uid} {
      // อ่านได้เฉพาะของตัวเอง หรือ Admin
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // สมัครใหม่ได้เฉพาะ SUPERVISOR สถานะ PENDING (กันสมัครตัวเองเป็น ADMIN / ACTIVE)
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'SUPERVISOR'
        && request.resource.data.status == 'PENDING'
        && request.resource.data.keys().hasOnly(
             ['username', 'name', 'code', 'role', 'position', 'phone', 'status', 'registeredAt']);
      // อนุมัติ/ระงับ/ลบ ได้เฉพาะ Admin
      allow update, delete: if isAdmin();
    }

    // ---- ข้อมูลที่ รปภ. ทั่วไปดูได้ (อ่านสาธารณะ) / แก้ไขได้เฉพาะ Supervisor-Admin ที่อนุมัติแล้ว ----
    // ชื่อ collection ตรงกับที่ app.js ใช้: schedules/{cycle}/rows/{no}, leaveRecords/{id}, spareArrivals/{id}, roster/main, settings/holidays
    // ตารางเวร: Supervisor/Admin แก้ไขได้ แต่ "ลบ" (ใช้ในปุ่มรีเซ็ต Master) ได้เฉพาะ Admin
    match /schedules/{doc=**} {
      allow read: if true;
      allow create, update: if isActiveStaff();
      allow delete: if isAdmin();
    }
    match /leaveRecords/{doc=**} { allow read: if true; allow write: if isActiveStaff(); }
    match /roster/{doc=**}       { allow read: if true; allow write: if isActiveStaff(); }
    match /spareArrivals/{doc=**} { allow read: if true; allow write: if isActiveStaff(); }
    match /positionSwaps/{doc=**} { allow read: if true; allow write: if isActiveStaff(); }

    // ---- ตั้งค่า / วันนักขัตฤกษ์: แก้ได้เฉพาะ Admin ----
    match /settings/{doc=**}     { allow read: if true; allow write: if isAdmin(); }

    // ---- อัตราค่าแรง: อ่านและแก้ไขได้เฉพาะ Admin เท่านั้น ----
    match /wageSettings/{doc=**} { allow read, write: if isAdmin(); }

    // ---- อย่างอื่นทั้งหมดปิด ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
